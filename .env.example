# =============================================================================
# DAKHLA TOURISM PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Governed strictly by AGENTS.md Rule 10 (Strict Secret Management)
# =============================================================================
#
# INSTRUCTIONS:
# Copy this file to '.env.local' and supply your project-specific credentials.
# NEVER commit '.env.local' or any file containing real API keys or passwords.
#

# --- 1. Supabase Client Configuration (Vite SPA) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- 2. Supabase Serverless & Administrative Keys ---
# Used exclusively by Edge Functions and secure administrative CLI/scripts.
# NEVER expose this key in client-side bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection URI (Required for running SQL DDL migrations via script)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- 3. Phase 1 Security & Authorization Test Harness ---
# Required for running SEC-01 through SEC-06 automated security test suites.
TEST_SUPABASE_URL=https://your-project-id.supabase.co
TEST_SUPABASE_ANON_KEY=your-supabase-anon-key

# Test Tourist User (Must possess role = 'tourist' in public.profiles)
TEST_TOURIST_EMAIL=sec-tourist@dakhlin.com
TEST_TOURIST_PASSWORD=YourSecureTestPassword123!

# Test Administrator User (Must possess role = 'admin' in public.profiles)
TEST_ADMIN_EMAIL=admin-test@dakhlin.com
TEST_ADMIN_PASSWORD=YourSecureAdminPassword123!

# --- 4. L7aj AI Concierge Configuration (Phase 5) ---
# Supabase Edge Secret (Set via Supabase CLI: supabase secrets set GEMINI_API_KEY=...)
# NEVER expose in frontend code!
GEMINI_API_KEY=your-google-gemini-flash-api-key
